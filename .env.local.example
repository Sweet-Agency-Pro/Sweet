# === Agence Sweet — variables d'environnement ===
# Copier en .env.local et renseigner les vraies valeurs (déjà présentes sur Vercel).

# URL canonique du site (sert aux métadonnées, canoniques, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.agence-sweet.com

# Supabase (contenu portfolio/services + auth admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 (chargé uniquement après consentement RGPD)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Chemins secrets de l'admin (gardés hors du code — le repo est public)
NEXT_PUBLIC_ADMIN_PATH=/studio-ombre-87
NEXT_PUBLIC_LOGIN_PATH=/acces-prive-87
